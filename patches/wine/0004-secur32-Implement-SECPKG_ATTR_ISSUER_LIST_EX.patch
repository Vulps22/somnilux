From 7859394df7c1483ecdcaf7232260d3ac0028eaad Mon Sep 17 00:00:00 2001
From: Vulps22 <ajmcallister5@gmail.com>
Date: Wed, 19 Aug 2026 03:27:31 +0100
Subject: [PATCH 4/4] secur32: Implement SECPKG_ATTR_ISSUER_LIST_EX.

Wine defines the SECPKG_ATTR_ISSUER_LIST_EX constant and the
SecPkgContext_IssuerListInfoEx result struct but never implemented
the attribute itself; QueryContextAttributes fell through to
SEC_E_UNSUPPORTED_FUNCTION for it.

.NET's SslStream queries this attribute, right after a server's
CertificateRequest, to learn which CAs it will accept before
selecting a client certificate to send. Without it, certificate
selection finds nothing and the client proceeds anonymously even
when it has a usable certificate available.

cert_retrieve_cb() in schannel_gnutls.c now deep-copies the
req_ca_rdn array GnuTLS hands it (only valid for the callback's
lifetime) into the session's schan_transport, since the app asks for
it afterwards rather than during the callback itself.
schan_get_issuers() serves it with the same two-call size-query
protocol as schan_get_session_peer_certificate(). schannel.c builds
the SecPkgContext_IssuerListInfoEx result as a single allocation
holding the CERT_NAME_BLOB array followed by the DN bytes it points
at, freed by the caller with one FreeContextBuffer, the same
convention SECPKG_ATTR_ENDPOINT_BINDINGS already uses. An empty
issuer list (cIssuers = 0) means the server named no CAs, which is a
legal "any certificate will do".
---
 dlls/secur32/schannel.c        |  45 +++++++++++++++
 dlls/secur32/schannel_gnutls.c | 102 +++++++++++++++++++++++++++++++++
 dlls/secur32/secur32_priv.h    |   9 +++
 3 files changed, 156 insertions(+)

diff --git a/dlls/secur32/schannel.c b/dlls/secur32/schannel.c
index 8ad7320..f9ededb 100644
--- a/dlls/secur32/schannel.c
+++ b/dlls/secur32/schannel.c
@@ -1419,6 +1419,51 @@ static SECURITY_STATUS SEC_ENTRY schan_QueryContextAttributesW(
         *cert = CertDuplicateCertificateContext(ctx->cert);
         return SEC_E_OK;
     }
+    case SECPKG_ATTR_ISSUER_LIST_EX:
+    {
+        SecPkgContext_IssuerListInfoEx *list = buffer;
+        ULONG count = 0, size = 0;
+        struct get_issuers_params params = { ctx->session, NULL, &size, &count };
+        BYTE *blob, *data;
+        ULONG *sizes;
+        unsigned int i;
+
+        status = GNUTLS_CALL( get_issuers, &params );
+        if (status != SEC_E_BUFFER_TOO_SMALL && status != SEC_E_OK) return status;
+
+        if (!count)
+        {
+            list->cIssuers = 0;
+            list->aIssuers = NULL;
+            return SEC_E_OK;
+        }
+
+        if (!(blob = RtlAllocateHeap(GetProcessHeap(), HEAP_ZERO_MEMORY,
+                                     count * sizeof(CERT_NAME_BLOB) + size)))
+            return SEC_E_INSUFFICIENT_MEMORY;
+
+        params.buffer = blob + count * sizeof(CERT_NAME_BLOB);
+        params.bufsize = &size;
+        params.retcount = &count;
+        if ((status = GNUTLS_CALL( get_issuers, &params )) != SEC_E_OK)
+        {
+            RtlFreeHeap(GetProcessHeap(), 0, blob);
+            return status;
+        }
+
+        sizes = (ULONG *)(blob + count * sizeof(CERT_NAME_BLOB));
+        data = (BYTE *)(sizes + count);
+        list->aIssuers = (PCERT_NAME_BLOB)blob;
+        list->cIssuers = count;
+        for (i = 0; i < count; i++)
+        {
+            ULONG len = sizes[i];
+            list->aIssuers[i].cbData = len;
+            list->aIssuers[i].pbData = data;
+            data += len;
+        }
+        return SEC_E_OK;
+    }
     case SECPKG_ATTR_CONNECTION_INFO:
     {
         SecPkgContext_ConnectionInfo *info = buffer;
diff --git a/dlls/secur32/schannel_gnutls.c b/dlls/secur32/schannel_gnutls.c
index a17ead3..973fd49 100644
--- a/dlls/secur32/schannel_gnutls.c
+++ b/dlls/secur32/schannel_gnutls.c
@@ -216,6 +216,9 @@ struct schan_transport
     BOOL async_abort;
     int async_result;
 
+    gnutls_datum_t *issuers;
+    unsigned int issuer_count;
+
     BYTE *parked_in;
     SIZE_T parked_in_size;
     SIZE_T parked_in_offset;
@@ -685,6 +688,13 @@ static NTSTATUS schan_dispose_session( void *args )
         pthread_cond_destroy(&t->async_cond);
     }
 
+    if (t->issuers)
+    {
+        unsigned int i;
+
+        for (i = 0; i < t->issuer_count; i++) free(t->issuers[i].data);
+        free(t->issuers);
+    }
     free(t->parked_in);
 
     pgnutls_transport_set_ptr(s, NULL);
@@ -778,6 +788,41 @@ static int cert_retrieve_cb(gnutls_session_t session, const gnutls_datum_t *req_
 
     pthread_mutex_lock(&t->async_mutex);
 
+    if (nreqs > 0 && req_ca_rdn)
+    {
+        gnutls_datum_t *copy = calloc(nreqs, sizeof(*copy));
+
+        if (copy)
+        {
+            int i, copied = 0;
+
+            for (i = 0; i < nreqs; i++)
+            {
+                if (!req_ca_rdn[i].size) continue;
+                if (!(copy[copied].data = malloc(req_ca_rdn[i].size))) break;
+                memcpy(copy[copied].data, req_ca_rdn[i].data, req_ca_rdn[i].size);
+                copy[copied].size = req_ca_rdn[i].size;
+                copied++;
+            }
+            if (i == nreqs)
+            {
+                unsigned int j;
+
+                for (j = 0; j < t->issuer_count; j++) free(t->issuers[j].data);
+                free(t->issuers);
+                t->issuers = copy;
+                t->issuer_count = copied;
+            }
+            else
+            {
+                int j;
+
+                for (j = 0; j < copied; j++) free(copy[j].data);
+                free(copy);
+            }
+        }
+    }
+
     if (!t->async_new_creds && !t->async_abort)
     {
         TRACE("Server requested a client certificate but none is available yet; "
@@ -1415,6 +1460,42 @@ static NTSTATUS schan_get_session_peer_certificate( void *args )
     return SEC_E_OK;
 }
 
+static NTSTATUS schan_get_issuers( void *args )
+{
+    const struct get_issuers_params *params = args;
+    gnutls_session_t s = session_from_handle(params->session);
+    struct schan_transport *t = (struct schan_transport *)pgnutls_transport_get_ptr(s);
+    unsigned int i, size, count;
+    ULONG *sizes;
+    BYTE *ptr;
+
+    if (!t) return SEC_E_INTERNAL_ERROR;
+
+    count = t->issuer_count;
+    size = count * sizeof(*sizes);
+    for (i = 0; i < count; i++) size += t->issuers[i].size;
+
+    if (!params->buffer || *params->bufsize < size)
+    {
+        *params->bufsize = size;
+        *params->retcount = count;
+        return SEC_E_BUFFER_TOO_SMALL;
+    }
+
+    sizes = (ULONG *)params->buffer;
+    ptr = params->buffer + count * sizeof(*sizes);
+    for (i = 0; i < count; i++)
+    {
+        sizes[i] = t->issuers[i].size;
+        memcpy(ptr, t->issuers[i].data, t->issuers[i].size);
+        ptr += t->issuers[i].size;
+    }
+
+    *params->bufsize = size;
+    *params->retcount = count;
+    return SEC_E_OK;
+}
+
 static NTSTATUS schan_send( void *args )
 {
     const struct send_params *params = args;
@@ -1973,6 +2054,7 @@ const unixlib_entry_t __wine_unix_call_funcs[] =
     schan_get_cipher_info,
     schan_get_connection_info,
     schan_get_enabled_protocols,
+    schan_get_issuers,
     schan_get_key_signature_algorithm,
     schan_get_max_message_size,
     schan_get_session_cipher_block_size,
@@ -2124,6 +2206,25 @@ static NTSTATUS wow64_schan_get_session_peer_certificate( void *args )
     return schan_get_session_peer_certificate(&params);
 }
 
+static NTSTATUS wow64_schan_get_issuers( void *args )
+{
+    struct
+    {
+        schan_session session;
+        PTR32 buffer;
+        PTR32 bufsize;
+        PTR32 retcount;
+    } const *params32 = args;
+    struct get_issuers_params params =
+    {
+        params32->session,
+        ULongToPtr(params32->buffer),
+        ULongToPtr(params32->bufsize),
+        ULongToPtr(params32->retcount),
+    };
+    return schan_get_issuers(&params);
+}
+
 static NTSTATUS wow64_schan_get_unique_channel_binding( void *args )
 {
     struct
@@ -2310,6 +2411,7 @@ const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
     wow64_schan_get_cipher_info,
     wow64_schan_get_connection_info,
     schan_get_enabled_protocols,
+    wow64_schan_get_issuers,
     schan_get_key_signature_algorithm,
     schan_get_max_message_size,
     schan_get_session_cipher_block_size,
diff --git a/dlls/secur32/secur32_priv.h b/dlls/secur32/secur32_priv.h
index e01be79..791d9ac 100644
--- a/dlls/secur32/secur32_priv.h
+++ b/dlls/secur32/secur32_priv.h
@@ -142,6 +142,14 @@ struct get_session_peer_certificate_params
     ULONG *retcount;
 };
 
+struct get_issuers_params
+{
+    schan_session session;
+    BYTE *buffer;          /* Starts with array of ULONG sizes, followed by contiguous data blob. */
+    ULONG *bufsize;
+    ULONG *retcount;
+};
+
 struct get_unique_channel_binding_params
 {
     schan_session session;
@@ -238,6 +246,7 @@ enum schan_funcs
     unix_get_cipher_info,
     unix_get_connection_info,
     unix_get_enabled_protocols,
+    unix_get_issuers,
     unix_get_key_signature_algorithm,
     unix_get_max_message_size,
     unix_get_session_cipher_block_size,
-- 
2.55.0

