 static NTSTATUS schan_dispose_session( void *args )
 {
     const struct session_params *params = args;
     gnutls_session_t s = session_from_handle(params->session);
     struct schan_transport *t = (struct schan_transport *)pgnutls_transport_get_ptr(s);
+
+    if (t->async_capable)
+    {
+        pthread_mutex_lock(&t->async_mutex);
+        if (t->async_state == ASYNC_PARKED)
+        {
+            t->in.desc = NULL;
+            t->out.desc = NULL;
+            t->async_abort = TRUE;
+            pthread_cond_broadcast(&t->async_cond);
+            while (t->async_state != ASYNC_DONE)
+                pthread_cond_wait(&t->async_cond, &t->async_mutex);
+        }
+        pthread_mutex_unlock(&t->async_mutex);
+        if (t->async_state == ASYNC_DONE) pthread_join(t->async_thread, NULL);
+        pthread_mutex_destroy(&t->async_mutex);
+        pthread_cond_destroy(&t->async_cond);
+    }
+
+    free(t->parked_in);
+
     pgnutls_transport_set_ptr(s, NULL);
     pgnutls_deinit(s);
     free(t);
