+static int cert_retrieve_cb(gnutls_session_t session, const gnutls_datum_t *req_ca_rdn, int nreqs,
+                             const gnutls_pk_algorithm_t *pk_algos, int pk_algos_length,
+                             gnutls_pcert_st **pcerts, unsigned int *pcert_length, gnutls_privkey_t *privkey)
+{
+    struct schan_transport *t = (struct schan_transport *)pgnutls_transport_get_ptr(session);
+    struct schan_cert_creds *cc;
+
+    pthread_mutex_lock(&t->async_mutex);
+
+    if (!t->async_new_creds && !t->async_abort)
+    {
+        TRACE("Server requested a client certificate but none is available yet; "
+              "parking the handshake until the app retries with one.\n");
+
+        if (!t->parked_in)
+        {
+            SIZE_T total = 0, chunk;
+            char *src;
+
+            for (;;)
+            {
+                BYTE *grown;
+
+                chunk = ~(SIZE_T)0;
+                if (!(src = get_buffer(&t->in, &chunk)) || !chunk) break;
+                if (!(grown = realloc(t->parked_in, total + chunk))) break;
+                t->parked_in = grown;
+                memcpy(t->parked_in + total, src, chunk);
+                total += chunk;
+                t->in.offset += chunk;
+            }
+            t->parked_in_size = total;
+            t->parked_in_offset = 0;
+            if (!total)
+            {
+                free(t->parked_in);
+                t->parked_in = NULL;
+            }
+        }
+
+        t->async_state = ASYNC_PARKED;
+        pthread_cond_broadcast(&t->async_cond);
+        do
+        {
+            pthread_cond_wait(&t->async_cond, &t->async_mutex);
+        } while (!t->async_new_creds && !t->async_abort);
+        TRACE("Resuming handshake with a certificate now available.\n");
+        t->async_state = ASYNC_RUNNING;
+    }
+
+    cc = t->async_abort ? NULL : t->async_new_creds;
+    pthread_mutex_unlock(&t->async_mutex);
+
+    if (!cc || !cc->has_cert)
+    {
+        *pcert_length = 0;
+        *privkey = NULL;
+        return 0;
+    }
+
+    *pcerts = &cc->pcert;
+    *pcert_length = 1;
+    *privkey = cc->privkey;
+    return 0;
+}
