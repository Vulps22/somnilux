+static NTSTATUS schan_update_session_creds( void *args )
+{
+    const struct update_session_creds_params *params = args;
+    gnutls_session_t s = session_from_handle(params->session);
+    struct schan_transport *t = (struct schan_transport *)pgnutls_transport_get_ptr(s);
+    struct schan_cert_creds *cc = cert_creds_from_handle(params->credentials);
+    int err;
+
+    if (!cc->has_cert)
+    {
+        TRACE("Supplied credential carries no certificate; leaving the session's "
+              "credentials alone.\n");
+        return STATUS_SUCCESS;
+    }
+
+    err = pgnutls_credentials_set(s, GNUTLS_CRD_CERTIFICATE, cc->gnutls_creds);
+    if (err != GNUTLS_E_SUCCESS)
+    {
+        pgnutls_perror(err);
+        return STATUS_INTERNAL_ERROR;
+    }
+
+    if (t->async_capable)
+    {
+        pthread_mutex_lock(&t->async_mutex);
+        t->async_new_creds = cc;
+        pthread_mutex_unlock(&t->async_mutex);
+    }
+
+    return STATUS_SUCCESS;
+}
