+static void *async_handshake_thread(void *arg)
+{
+    struct schan_transport *t = arg;
+    int err;
+
+    on_async_worker_thread = TRUE;
+    err = do_gnutls_handshake_with_retry(t->session);
+
+    pthread_mutex_lock(&t->async_mutex);
+    t->async_state = ASYNC_DONE;
+    t->async_result = err;
+    pthread_cond_broadcast(&t->async_cond);
+    pthread_mutex_unlock(&t->async_mutex);
+    return NULL;
+}
+
+static NTSTATUS schan_run_async_handshake( struct schan_transport *t, gnutls_session_t s )
+{
+    NTSTATUS status;
+    int err;
+
+    pthread_mutex_lock(&t->async_mutex);
+
+    if (t->async_state == ASYNC_IDLE)
+    {
+        t->async_state = ASYNC_RUNNING;
+        if (pthread_create(&t->async_thread, NULL, async_handshake_thread, t))
+        {
+            t->async_state = ASYNC_IDLE;
+            pthread_mutex_unlock(&t->async_mutex);
+            ERR("Failed to start handshake worker thread\n");
+            return SEC_E_INTERNAL_ERROR;
+        }
+    }
+    else
+    {
+        if (!t->async_new_creds)
+        {
+            TRACE("Retry has no certificate yet; leaving the handshake parked "
+                  "and asking again.\n");
+            pthread_mutex_unlock(&t->async_mutex);
+            return SEC_I_INCOMPLETE_CREDENTIALS;
+        }
+        /* Must be set before the broadcast, or the wait below misses the wakeup. */
+        t->async_state = ASYNC_RUNNING;
+        pthread_cond_broadcast(&t->async_cond);
+    }
+
+    while (t->async_state == ASYNC_RUNNING)
+        pthread_cond_wait(&t->async_cond, &t->async_mutex);
+
+    if (t->async_state == ASYNC_PARKED)
+    {
+        pthread_mutex_unlock(&t->async_mutex);
+        return SEC_I_INCOMPLETE_CREDENTIALS;
+    }
+
+    pthread_mutex_unlock(&t->async_mutex);
+    pthread_join(t->async_thread, NULL);
+    err = t->async_result;
+    t->async_state = ASYNC_IDLE;
+
+    status = handshake_status_from_err(s, err);
+    return status;
+}
